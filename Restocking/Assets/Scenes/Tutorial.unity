  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 53634328}
  waitingSymbol: {fileID: 1102410506}
  dialogueTextBox: {fileID: 1111148175}
  charImg: {fileID: 152547482}
  RM: {fileID: 533743990}
  dialogue:
  - Welcome! I'm the New Employees Trainer, or NET for short!
  - It says here that you're working on restocking our facility.
  - That's basically just moving a lot of packages from one place to another.
  - But don't worry, we have a fleet of ready-to-be-programmed robots at your disposal!
  - Well... we couldn't spring for the fancy ones, so these ones can only hold up
    to five commands...
  - They'll just loop through their instructions, so I'm sure you can figure something
    out!
  - But anyways, I'll let you get to work! Good luck!
  dialogueImgs:
  - {fileID: 21300000, guid: 5cf056fdfd2e443999c4b0097f0b071c, type: 3}
  - {fileID: 21300000, guid: df9058e1b99d345ac9e12dd3ee4d40cc, type: 3}
