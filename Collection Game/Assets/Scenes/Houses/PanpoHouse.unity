  m_Name: 
  m_EditorClassIdentifier: 
  residentName: Panpo
  quotes:
  - 'Hello! I''m Panpo!|I design furniture and plushes! '
  - "Hmm\u2026 what should I make next?"
  - 'I''m hard at work!|I''m so proud, I''ve made so much progress! '
  - 'This bread plushie is something I designed!|It''s very comfy to sit on! '
  - "I'm thinking of ideas!|Koi pond design\u2026 or maybe bamboo forest?|Hmm\u2026 "
  - 'I think I might go out to get some inspiration! '
  - 'Favorite drink...|Maybe a warm tea?|It''s so refreshing! '
  - "Hmm\u2026|I think either the flower bunny or the pufpuf is my favorite creature! "
  - 'I want to be in some place well decorated|From having lots of shops|To having
    lots of nature sights, like ponds, forests, waterfalls|I want it to be a beautiful
    sight to see! '
  move: 0
  speed: 0.5
  dialogue: 0
  targetPos: {x: 0, y: 0, z: 0}
